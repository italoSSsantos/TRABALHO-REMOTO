full address:s:192.168.0.244
username:s:MSPTI\italoapds

; ---------------------------------------------------------------
; AUDIO - e isto que o Chrome Remote Desktop nao fazia
; ---------------------------------------------------------------
; audiomode 0        = o som do PC toca AQUI no notebook
; audiocapturemode 1 = o microfone DAQUI vira microfone do PC  <<<
; audioqualitymode 0 = dinamico, se ajusta a rede (1=medio, 2=alto)
audiomode:i:0
audiocapturemode:i:1
audioqualitymode:i:0

; camera do notebook tambem vai, para videochamada
camerastoredirect:s:*

; ---------------------------------------------------------------
; Tela
; ---------------------------------------------------------------
screen mode id:i:2
dynamic resolution:i:1
smart sizing:i:1
desktopscalefactor:i:100
use multimon:i:0

; ---------------------------------------------------------------
; Rede - LAN, entao pode usar tudo no talo
; ---------------------------------------------------------------
networkautodetect:i:1
bandwidthautodetect:i:1
connection type:i:7
compression:i:1
videoplaybackmode:i:1
redirectdirectx:i:1

; ---------------------------------------------------------------
; Conveniencias
; ---------------------------------------------------------------
redirectclipboard:i:1
redirectprinters:i:0
redirectsmartcards:i:0
drivestoredirect:s:
keyboardhook:i:2
autoreconnection enabled:i:1
authentication level:i:2
prompt for credentials:i:0
negotiate security layer:i:1
enablecredsspsupport:i:1

; ---------------------------------------------------------------
; Efeitos visuais - desligados para a voz ter prioridade
; ---------------------------------------------------------------
allow font smoothing:i:1
allow desktop composition:i:0
disable wallpaper:i:1
disable full window drag:i:1
disable menu anims:i:1
disable themes:i:0
bitmapcachepersistenable:i:1
